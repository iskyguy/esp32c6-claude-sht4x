	(text "Q1 switches 3V3 to SHT41 + Qwiic + OLED (VPERIPH).\nPERIPH_EN_N (GPIO3) low = on. Off by default and in\ndeep sleep (gate pulled up). Bridge JP1 = always on.\n10k/100n gives a soft turn-on (no 3V3 dip)."
		(exclude_from_sim no)
		(at 256.54 91.44 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "04fb26ea-40d9-5fba-b4ef-40999c46ab81")
	)
	(text "SHT41 + I2C PORTS (all on VPERIPH)"
		(exclude_from_sim no)
		(at 13.97 247.65 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0a01cc03-6ba0-5db1-ac46-4bd3bca2299f")
	)
	(text "VDDA3P3 (RF)"
		(exclude_from_sim no)
		(at 165.1 137.795 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "0ef73dc5-2b33-5131-b1e6-0a8dd94e3f34")
	)
	(text "Qwiic / STEMMA QT: 1 GND, 2 3V3, 3 SDA, 4 SCL"
		(exclude_from_sim no)
		(at 121.92 282.575 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "23522bac-a964-5b1e-b6ac-6bed750a5a1c")
	)
	(text "ESP32-C6FH8 (QFN32, 8 MB in-package flash) - Wi-Fi 6 / BLE / 802.15.4 (Zigbee, Thread)"
		(exclude_from_sim no)
		(at 13.97 123.19 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "26a662eb-a081-5554-b955-4fdd1ea0e981")
	)
	(text "2.4 GHz chip antenna shared by Wi-Fi and Zigbee/Thread.\n50 ohm feed, pi network next to the chip pin; fit 0R in\nseries and tune with a VNA on the finished board.\nKeep-out under/around AE1 per Johanson layout."
		(exclude_from_sim no)
		(at 15.24 129.54 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "37f862a9-0fe6-5884-a44b-83efa0a32d2c")
	)
	(text "VSYS = USB (4.4 V) or battery via BQ24074 power path.\nXC6220: 3.3 V / 700 mA, ~8 uA quiescent."
		(exclude_from_sim no)
		(at 256.54 81.28 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "55882db9-f3a7-5aed-87ff-70f478ea57ba")
	)
	(text "VBAT / 2 to ADC1_CH2 (GPIO2).\n~2 uA divider drain."
		(exclude_from_sim no)
		(at 15.24 186.69 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "56919664-c1fe-5d65-8e91-758135e7fcb1")
	)
	(text "USB-C INPUT (power + native USB data)"
		(exclude_from_sim no)
		(at 13.97 29.21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5a90af21-6973-531f-8386-e4f1ef8763db")
	)
	(text "ISET 3.6k -> ~250 mA charge (I = 890/R).\nEN2=0, EN1=1 -> 500 mA USB input limit.\nTS 10k = no battery NTC. TMR/ITERM open\n= default timers / 10% termination.\nJ2: pin 1 = BAT+, pin 2 = GND.\nCHECK BATTERY POLARITY before plugging in."
		(exclude_from_sim no)
		(at 190.5 81.28 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "6697d3e7-ff40-5725-85c4-c9385d0c54f2")
	)
	(text "RESET / BOOT / STRAPS / STATUS"
		(exclude_from_sim no)
		(at 273.05 123.19 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7388a4aa-7054-5ca1-9460-6407139659aa")
	)
	(text "OLED module order:\nGND VCC SCL SDA\n(SSD1306 0.91\"/0.96\")\nI2C: SDA=GPIO22\n     SCL=GPIO23"
		(exclude_from_sim no)
		(at 261.62 259.08 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "9026ab05-3960-557f-afb7-853e7dfd220e")
	)
	(text "CC1/CC2 5.1k pull-downs: sink, default USB power (500 mA).\nD+/D- go straight to the ESP32-C6 USB Serial/JTAG (GPIO13/GPIO12)."
		(exclude_from_sim no)
		(at 15.24 109.22 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "93639324-40cc-5a59-bd2a-a96a301f69b4")
	)
	(text "GPIO9 low at reset = download mode\n(GPIO8 must be high: 10k pull-up).\nNormal flashing is over USB-C; the\nbuttons are the manual fallback.\nTP1/TP2: UART0 console pads."
		(exclude_from_sim no)
		(at 332.74 208.28 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "9cb4d4d8-01e5-580f-b5d0-bfc8bfafdb21")
	)
	(text "LI-ION CHARGER + POWER PATH (BQ24074)"
		(exclude_from_sim no)
		(at 115.57 29.21 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a1329716-f04a-5616-ba55-8f8d753f29d2")
	)
	(text "Load caps: 2 x (CL - Cstray). R on XTAL_P may become\n~24 nH to suppress harmonics (Espressif guideline)."
		(exclude_from_sim no)
		(at 50.8 217.17 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "b772da7e-1db0-5d1d-912e-b282d189bace")
	)
